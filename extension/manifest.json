{
  "manifest_version": 3,
  "name": "JD Remote 쿠키 도우미",
  "version": "1.1.1",
  "description": "terabox.com 로그인 쿠키를 내 JD Remote 서버로 보내 JDownloader 계정을 갱신합니다. 로그인하면 자동 전송(선택).",
  "permissions": [
    "cookies",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://*.terabox.com/*",
    "https://*.1024terabox.com/*",
    "https://*.terabox.app/*",
    "https://*.teraboxapp.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "JD Remote 쿠키 도우미"
  },
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
