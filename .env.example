# 로그인은 JD 컨테이너(jlesage webauth, noVNC 계정)에 위임 — 여기에 비밀번호를 두지 않는다.
JD_WEB_URL=http://jdownloader2:5800
# 세션 서명 키. 고정해야 컨테이너 재시작 후에도 로그인이 유지됨. 생성: openssl rand -base64 32
JDR_SECRET=
# JD 로컬 RemoteAPI (jdnet 네트워크에서 컨테이너 이름으로)
JD_API_URL=http://jdownloader2:3128
# JD 컨테이너 안 다운로드 루트와, 같은 폴더의 NAS 호스트 경로(화면 표시용)
JD_OUTPUT_PREFIX=/output
DOWNLOAD_ROOT=/volume1/<share>/Downloads
# 배너/설정 링크
NOVNC_URL=https://jd.<your-domain>
DSM_URL=https://dsm.<your-domain>
# 폰에서 TeraBox 쿠키를 갱신하는 NAS 크롬(browser/). 상단 🌐 아이콘. 비우면 숨김
BROWSER_URL=https://browser.<your-domain>
# 폴링(ms), 로그인 유지(일)
POLL_MS=3000
COOKIE_DAYS=30
TZ=Asia/Seoul
